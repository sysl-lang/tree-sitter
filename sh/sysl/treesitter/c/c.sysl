// tree-sitter as C reaches it: the records `api.h` hands over by value, and one `extern` per entry
// point this package uses, transcribed from the header.
//
// **Nothing here is meant to be called by a program.** A node is four words of somebody else's
// bookkeeping, a string is a `const char *` whose owner varies from call to call, and a failure is an
// out-parameter. The module above turns those into `&Parser`, `&Tree`, `Node` and `&Query` values
// that free what they own, and is what an application imports.
//
// **There is no shim.** tree-sitter's API is records of scalars handed over by value, which sysl
// passes in C's registers itself, and its three callbacks are reached by `@export`ed trampolines in
// the module above. Every record below has its `sizeof` checked against the header's in the tests,
// because a field transcribed wrongly links perfectly and reads the wrong bytes.

module sh.sysl.treesitter.c

@link("tree-sitter")

@include("tree_sitter/api.h")

// ## The records
//
// Field for field the C's. `TSNode` and `TSTreeCursor` are opaque in meaning but not in size: the
// caller holds them, so their layout has to be spelled even though nothing reads the fields.

struct Point
    row: u32
    column: u32

struct Range
    start_point: Point
    end_point: Point
    start_byte: u32
    end_byte: u32

struct InputEdit
    start_byte: u32
    old_end_byte: u32
    new_end_byte: u32
    start_point: Point
    old_end_point: Point
    new_end_point: Point

struct Node
    context: [4]u32
    id: *u8
    tree: *u8

struct TreeCursor
    tree: *u8
    id: *u8
    context: [3]u32

struct QueryCapture
    node: Node
    index: u32

struct QueryMatch
    id: u32
    pattern_index: u16
    capture_count: u16
    captures: *QueryCapture

struct PredicateStep
    kind: u32
    value_id: u32

/** `TSInput`: the read callback answers a chunk starting at `byte_index` and its length. */
struct Input
    payload: *u8
    read: *extern(*u8, u32, Point, *u32) -> *u8
    encoding: u32
    decode: *u8

/** `TSLogger`. */
struct Logger
    payload: *u8
    log: *extern(*u8, u32, *u8) -> unit

// The opaque handles. Nothing on this side ever sees inside one.
opaque struct Language
opaque struct Parser
opaque struct Tree
opaque struct Query
opaque struct QueryCursor

// ## The sizes and the numbers, asked for rather than written down

c const
    NODE_SIZE:          usize = "sizeof(TSNode)"
    CURSOR_SIZE:        usize = "sizeof(TSTreeCursor)"
    RANGE_SIZE:         usize = "sizeof(TSRange)"
    EDIT_SIZE:          usize = "sizeof(TSInputEdit)"
    CAPTURE_SIZE:       usize = "sizeof(TSQueryCapture)"
    MATCH_SIZE:         usize = "sizeof(TSQueryMatch)"
    INPUT_SIZE:         usize = "sizeof(TSInput)"
    LOGGER_SIZE:        usize = "sizeof(TSLogger)"
    STEP_SIZE:          usize = "sizeof(TSQueryPredicateStep)"

    LANGUAGE_VERSION:   u32 = "TREE_SITTER_LANGUAGE_VERSION"
    MIN_COMPATIBLE_LANGUAGE_VERSION: u32 = "TREE_SITTER_MIN_COMPATIBLE_LANGUAGE_VERSION"

    ENCODING_UTF8:      u32 = "TSInputEncodingUTF8"

    LOG_PARSE:          u32 = "TSLogTypeParse"
    LOG_LEX:            u32 = "TSLogTypeLex"

    STEP_DONE:          u32 = "TSQueryPredicateStepTypeDone"
    STEP_CAPTURE:       u32 = "TSQueryPredicateStepTypeCapture"
    STEP_STRING:        u32 = "TSQueryPredicateStepTypeString"

    QUERY_ERROR_NONE:      u32 = "TSQueryErrorNone"
    QUERY_ERROR_SYNTAX:    u32 = "TSQueryErrorSyntax"
    QUERY_ERROR_NODE_TYPE: u32 = "TSQueryErrorNodeType"
    QUERY_ERROR_FIELD:     u32 = "TSQueryErrorField"
    QUERY_ERROR_CAPTURE:   u32 = "TSQueryErrorCapture"
    QUERY_ERROR_STRUCTURE: u32 = "TSQueryErrorStructure"
    QUERY_ERROR_LANGUAGE:  u32 = "TSQueryErrorLanguage"

    QUANTIFIER_ZERO:         u32 = "TSQuantifierZero"
    QUANTIFIER_ZERO_OR_ONE:  u32 = "TSQuantifierZeroOrOne"
    QUANTIFIER_ZERO_OR_MORE: u32 = "TSQuantifierZeroOrMore"
    QUANTIFIER_ONE:          u32 = "TSQuantifierOne"
    QUANTIFIER_ONE_OR_MORE:  u32 = "TSQuantifierOneOrMore"

    SYMBOL_REGULAR:     u32 = "TSSymbolTypeRegular"
    SYMBOL_ANONYMOUS:   u32 = "TSSymbolTypeAnonymous"
    SYMBOL_SUPERTYPE:   u32 = "TSSymbolTypeSupertype"
    SYMBOL_AUXILIARY:   u32 = "TSSymbolTypeAuxiliary"

// What `ts_node_string` and `ts_tree_get_changed_ranges` hand back is the caller's to free, with the
// allocator tree-sitter was built with — the system one, since nothing here calls `ts_set_allocator`.
extern "free" free(p: *u8)

