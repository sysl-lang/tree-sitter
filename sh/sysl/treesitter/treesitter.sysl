module sh.sysl.treesitter

import sh.sysl.treesitter.c
import sysl.slices.as_ptr
import sysl.text.from_cstring

// tree-sitter, bound for sysl: an incremental parser that turns text into a concrete syntax tree,
// re-parses an edited text by reusing what did not change, and answers structural queries over the
// tree.
//
//     import sh.sysl.treesitter.{parser, query}
//     import sh.sysl.treesitter.json.json_language
//
//     val p = parser()
//     p.set_language(json_language())?
//     val tree = p.parse("[1, 2]")?
//     print(tree.root().sexp())      // (document (array (number) (number)))
//
// **A grammar is a C function answering a `*TSLanguage`**, generated by `tree-sitter generate` into
// a `parser.c`. This package carries one, JSON, in `sh.sysl.treesitter.json`, and that module is
// the pattern for any other: a package holding the grammar's `parser.c` (and `scanner.c`) beside
// one `extern` and a function wrapping it in `Language`.
//
// **Ownership.** `Parser`, `Tree`, `Cursor`, `Query` and `QueryCursor` are `&T` boxes whose
// destructors call the matching `ts_*_delete` exactly once. A `Node` is a value — tree-sitter's own
// four words — that also holds its `&Tree`, so a node keeps the tree it points into alive rather than
// dangling when the tree's last other name goes.

// ## Where something is

/** A position as tree-sitter counts it: zero-based row, and a column in BYTES from the row's start. */
struct Point
    row: u32
    column: u32

/** A span of the text, both as positions and as byte offsets; the end is exclusive. tree-sitter's
 * `TSRange`, named so as not to collide with the prelude's `Range`.
 */
struct Span
    start: Point
    end: Point
    start_byte: u32
    end_byte: u32

impl Eq for Point
    eq(self, rhs: Point) -> bool = self.row == rhs.row && self.column == rhs.column

impl Eq for Span
    eq(self, rhs: Span) -> bool =
        self.start == rhs.start && self.end == rhs.end && self.start_byte == rhs.start_byte &&
            self.end_byte == rhs.end_byte

/** `(row, column)`, the way the CLI prints a position. */
impl Display for Point
    display(self, out: *Writer, fmt: FormatSpec) = out.write(s"(${self.row}, ${self.column})".bytes)

/** `[start - end]` with the byte offsets after them. */
impl Display for Span
    display(self, out: *Writer, fmt: FormatSpec) =
        out.write(s"[${self.start} - ${self.end}] bytes ${self.start_byte}..<${self.end_byte}".bytes)

private[treesitter] point_of(p: c.Point) -> Point = Point(p.row, p.column)

private[treesitter] c_point(p: Point) -> c.Point = c.Point(p.row, p.column)

private[treesitter] range_of(r: c.Range) -> Span =
    Span(point_of(r.start_point), point_of(r.end_point), r.start_byte, r.end_byte)

private[treesitter] c_range(r: Span) -> c.Range =
    c.Range(c_point(r.start), c_point(r.end), r.start_byte, r.end_byte)

/** Where byte `at` of `text` is: rows split at `\n`, columns counted in bytes. */
point_at(text: string, at: u32) -> Point
    val b = text.bytes
    var row: u32 = 0
    var column: u32 = 0

    for i in 0..<usize(at)
        if b[i] == u8('\n')
            row += 1
            column = 0
        else
            column += 1

    Point(row, column)
end point_at

// ## An edit

/** A change to the text, as `ts_tree_edit` wants it: the bytes `start_byte..<old_end_byte` were
 * replaced by ones now ending at `new_end_byte`, with the positions of all three.
 */
struct Edit
    start_byte: u32
    old_end_byte: u32
    new_end_byte: u32
    start: Point
    old_end: Point
    new_end: Point

/** The edit that replaces `old[start..<end]` with `inserted` — the positions worked out from the two
 * texts, which is the part a caller gets wrong by hand.
 */
replacement(old: string, start: u32, end: u32, inserted: string) -> Edit
    val new_end = start + u32(inserted.len)
    val at = point_at(old, start)
    var after = at

    for b in inserted.bytes
        if b == u8('\n')
            after = Point(after.row + 1, 0)
        else
            after = Point(after.row, after.column + 1)

    Edit(start, end, new_end, at, point_at(old, end), after)
end replacement

private[treesitter] c_edit(e: Edit) -> c.InputEdit =
    c.InputEdit(e.start_byte, e.old_end_byte, e.new_end_byte, c_point(e.start), c_point(e.old_end),
                c_point(e.new_end))

// ## A language

/** What kind of symbol a grammar declares. */
enum SymbolKind
    Regular
    Anonymous
    Supertype
    Auxiliary

/** A grammar, as `tree-sitter generate` compiled it. The storage is static C data, so a `Language`
 * is a pointer that may be copied freely.
 */
struct Language
    private[treesitter] raw: *c.Language

    /** The ABI version the grammar was generated for. */
    abi_version(self) -> u32 = c.language_abi_version(self.raw)

    /** The grammar's name, where it was generated with one (ABI 15 on). */
    name(self) -> Option[string] = text_or_none(c.language_name(self.raw))

    symbol_count(self) -> u32 = c.language_symbol_count(self.raw)

    symbol_name(self, s: u16) -> Option[string] = text_or_none(c.language_symbol_name(self.raw, s))

    symbol_kind(self, s: u16) -> SymbolKind
        val k = c.language_symbol_type(self.raw, s)

        if k == c.SYMBOL_REGULAR then Regular
        elif k == c.SYMBOL_ANONYMOUS then Anonymous
        elif k == c.SYMBOL_SUPERTYPE then Supertype
        else Auxiliary

    /** The symbol a node kind is spelled with, or `None` where the grammar has none by that name. */
    symbol_for(self, name: string, named: bool) -> Option[u16]
        val s = c.language_symbol_for_name(self.raw, bytes_ptr(name), u32(name.len), named)

        if s == 0 then None else Some(s)

    field_count(self) -> u32 = c.language_field_count(self.raw)

    field_name(self, id: u16) -> Option[string] = text_or_none(c.language_field_name_for_id(self.raw, id))

    field_id(self, name: string) -> Option[u16]
        val f = c.language_field_id_for_name(self.raw, bytes_ptr(name), u32(name.len))

        if f == 0 then None else Some(f)
end Language

/** A grammar's `tree_sitter_<name>()` answer, as a `Language`. This is what a grammar package calls. */
language(raw: *c.Language) -> Language = Language(raw)

/** The ABI versions this tree-sitter accepts, oldest and newest. */
abi_versions() -> (u32, u32) = (c.MIN_COMPATIBLE_LANGUAGE_VERSION, c.LANGUAGE_VERSION)

// ## What can go wrong

/** Why a parser refused. */
enum Error
    /** The grammar was generated for an ABI this library does not read. */
    VersionMismatch(found: u32, oldest: u32, newest: u32)

    /** `parse` was called before `set_language`. */
    NoLanguage

    /** The included ranges overlap or are out of order. */
    BadRanges

/** One sentence for an `Error`. */
describe(e: Error) -> string = e match
    VersionMismatch(found, oldest, newest) ->
        s"the grammar's ABI version is $found; this tree-sitter reads $oldest to $newest"
    NoLanguage -> "the parser has no language: call set_language first"
    BadRanges -> "the included ranges overlap or are out of order"

// ## The two string shapes C hands back

/** A `const char *` that is static or owned by somebody else, null meaning absent. */
private[treesitter] text_or_none(p: *u8) -> Option[string] =
    if p == null then None else from_cstring(p).ok()

/** A `const char *` that is always there. */
private[treesitter] text_of(p: *u8) -> string = text_or_none(p).unwrap_or("")

/** The front of a string's bytes, for a C function that also takes the length. */
private[treesitter] bytes_ptr(s: string) -> *u8 = as_ptr(s.bytes)
